{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server={DB_SERVER};Database={DB_DATABASE_NAME};User Id={DB_USERNAME};Password={DB_PASSWORD};TrustServerCertificate=True;"
  },
  "Cors": {
    "AllowedOrigins": [
      "prod.com"
    ]
  }
}
